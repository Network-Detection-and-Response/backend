# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# PostgreSQL (required)
DATABASE_URL=postgres://ndr:ndr@localhost:5432/ndr?sslmode=disable

# Sensor auth (required) — use a local fake value only
SENSOR_API_KEY=change-me-sensor-key

# CORS (comma-separated origins; no wildcard with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Ingestion limits (used in later stages)
MAX_BODY_BYTES=1048576
MAX_FLOWS_PER_BATCH=500
QUEUE_CAPACITY=100
WORKER_COUNT=2

# ML service (optional at bootstrap; required for predictions later)
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT=5s

# Decision agent
ATTACK_THRESHOLD=0.60
DDOS_CRITICAL_THRESHOLD=0.85
ATTACK_WINDOW=15m

# Telegram notifications (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM explanation (optional — leave empty to use templates)
LLM_API_KEY=
LLM_BASE_URL=

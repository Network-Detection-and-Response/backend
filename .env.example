# Copy to .env and adjust. Do not commit .env.

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://ndr:ndr@localhost:5432/ndr?sslmode=disable
SENSOR_API_KEY=change-me-sensor-key

# Optional ML (phase 04+); backend starts without it.
ML_SERVICE_URL=
ML_TIMEOUT=5s

ATTACK_THRESHOLD=0.60
DDOS_CRITICAL_THRESHOLD=0.85
ATTACK_WINDOW=15m

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_BODY_BYTES=1048576
MAX_FLOWS_PER_BATCH=500
QUEUE_CAPACITY=100
WORKER_COUNT=2

# Optional Telegram (phase 05+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM (not required)
LLM_API_KEY=
LLM_BASE_URL=

LOG_LEVEL=info
